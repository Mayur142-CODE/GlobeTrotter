# ==============================================================================
# GlobeTrotter Backend Environment Variables
# Copy this file to .env and fill in your actual Supabase project credentials.
# WARNING: NEVER commit your actual .env file with real secrets to version control.
# ==============================================================================

# Supabase Project URL (e.g., https://your-project-id.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous / Public / Publishable Key (safe for client/frontend requests)
SUPABASE_ANON_KEY=your-supabase-anon-public-key-here

# ------------------------------------------------------------------------------
# BACKEND ONLY SECRETS (NEVER expose to frontend / browser client)
# ------------------------------------------------------------------------------
# Supabase Service Role Secret Key (bypasses Row-Level Security, admin use only)
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Supabase Direct PostgreSQL Connection String (Optional for direct DB migrations/tools)
# SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres
